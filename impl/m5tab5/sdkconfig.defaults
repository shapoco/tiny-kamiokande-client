# M5Stack Tab5 (ESP32-P4)。ボード関連の値は texbreakout / ShapoGFX の demorig に倣う
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# USB-C しか無い
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Tab5 のチップ (v3 未満) では Flash は 40 MHz までなので、せめて既定の DIO を QIO にする
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# パネルのフレームバッファは PSRAM にある
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# ESP-IDF 5.5 の既定は v3.1 以上だが、Tab5 は v1.0
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_TASK_WDT_INIT=n

# HTTPS (api.php) の証明書
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 使わない画素形式と機能
CONFIG_SHAPOGFX_FORMAT_GRAY1=n
CONFIG_SHAPOGFX_FORMAT_RGB444=n
CONFIG_SHAPOGFX2D_RIG=n
CONFIG_SHAPOGFX2D_LVGL_FONT=n

# CoreS3 と同じ描画の設定 (SPEC.md 4.3)
CONFIG_SHAPOGFX3D_CORRECT_PERSPECTIVE=1
CONFIG_SHAPOGFX3D_FIXED_POINT=y

# WiFi: SDIO でつながった ESP32-C6 を esp_hosted + esp_wifi_remote で使う。Tab5 のピン (CLK 12, CMD 13, D0-D3 11/10/9/8,
# C6 のリセット 15) は esp_hosted のボードプリセットが持っている
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
# 受信のステージングは 1 スロット (ストリーミングモードでは 1536 × CP の送信キュー長 = 約 21 KB の内蔵 DMA メモリ)。
# 取得は 15 秒に 26 KB なので速度は要らない
CONFIG_ESP_HOSTED_HOST_SDIO_RX_STAGING_SLOTS=1
